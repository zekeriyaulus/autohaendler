---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, telHref } from "../config/site";

const brandNameNbsp = site.name.replace(/\s+/g, "\u00A0");
---

<BaseLayout
  title={`${site.name} – Gebrauchtwagen, Ankauf & Service in ${site.address.city}`}
  description={`${site.name}: Gebrauchtwagen, Fahrzeugankauf und Service in ${site.address.city}. Der aktuelle Fahrzeugbestand ist direkt über mobile.de erreichbar.`}
>
  <section class="premium-hero premium-hero--background full-bleed" aria-label="Startbereich CarVision Paderborn" style="margin-top:0;">
    <img class="premium-hero__bgImage" src="/uploads/carvision-cabrio-hero.png" alt="" loading="eager" decoding="async" />
    <div class="premium-hero__shade"></div>

    <div class="container premium-hero__inner">
      <div class="premium-hero__content">
        <div class="chip premium-hero__chip">Bad Lippspringe · Paderborn Umgebung</div>
        <h1 class="premium-hero__title">
          Gebrauchtwagen, Ankauf &amp; Service – <span>{brandNameNbsp}</span>
        </h1>
        <p class="premium-hero__text">
          Persönliche Beratung, faire Abwicklung und klare Kommunikation. Den aktuellen Fahrzeugbestand findet ihr direkt auf mobile.de – dort sind Bilder, Preise und Verfügbarkeit immer am aktuellsten.
        </p>

        <div class="premium-hero__actions">
          <a class="btn primary" href={site.mobileUrl} target="_blank" rel="noopener noreferrer">Fahrzeuge auf mobile.de ansehen</a>
          <a class="btn premium-hero__btnLight" href="/autoankauf/">Autoankauf / Inzahlungnahme</a>
          <a class="btn premium-hero__btnLight" href={telHref(site.phones[0])}>Jetzt anrufen</a>
        </div>
      </div>
    </div>

    <div class="hero-infobar" aria-label="Standort, Kontakt und Fahrzeugbestand">
      <div class="hero-infobar__inner card">
        <a class="hero-infobar__item" href="/kontakt/" style="--d: 0ms">
          <div class="hero-infobar__label">Standort</div>
          <div class="hero-infobar__value">{site.address.street}, {site.address.zip} {site.address.city}</div>
        </a>
        <a class="hero-infobar__item" href={telHref(site.phones[0])} style="--d: 160ms">
          <div class="hero-infobar__label">Telefon</div>
          <div class="hero-infobar__value">{site.phones[0]}</div>
        </a>
        <a class="hero-infobar__item" href={site.mobileUrl} target="_blank" rel="noopener noreferrer" style="--d: 320ms">
          <div class="hero-infobar__label">Fahrzeugbestand</div>
          <div class="hero-infobar__value">Aktuelle Fahrzeuge auf mobile.de ansehen</div>
        </a>
      </div>
    </div>
  </section>

  <section style="margin-top:26px;">
    <div class="grid services-grid" style="grid-template-columns:repeat(3, minmax(0,1fr));">
      <div class="card" style="padding:18px;">
        <div class="chip">01</div>
        <h2 class="h2" style="margin-top:12px;">Gebrauchtwagen</h2>
        <p class="small" style="margin:8px 0 0;line-height:1.7;">Ausgewählte Fahrzeuge mit klaren Informationen. Der aktuelle Bestand wird extern über mobile.de gepflegt.</p>
      </div>
      <div class="card" style="padding:18px;">
        <div class="chip">02</div>
        <h2 class="h2" style="margin-top:12px;">Fahrzeugankauf</h2>
        <p class="small" style="margin:8px 0 0;line-height:1.7;">Du möchtest dein Fahrzeug verkaufen oder in Zahlung geben? Wir klären die wichtigsten Daten direkt und unkompliziert.</p>
      </div>
      <div class="card" style="padding:18px;">
        <div class="chip">03</div>
        <h2 class="h2" style="margin-top:12px;">Service &amp; Beratung</h2>
        <p class="small" style="margin:8px 0 0;line-height:1.7;">Von Besichtigung bis Übergabe: Wir unterstützen bei Fragen rund um Kauf, Verkauf und Abwicklung.</p>
      </div>
    </div>
  </section>

  <hr class="sep" />

  <section class="card" style="padding:20px;display:grid;gap:18px;grid-template-columns:1.25fr .75fr;align-items:center;">
    <div>
      <span class="chip">Aktueller Bestand</span>
      <h2 class="h2" style="margin-top:12px;">Fahrzeuge direkt auf mobile.de ansehen</h2>
      <p class="p" style="margin:8px 0 0;">
        Damit Fahrzeugdaten nicht doppelt gepflegt werden müssen, ist der Fahrzeugbestand auf dieser Webseite nicht eingebunden. Der Button führt direkt zum aktuellen Händlerprofil auf mobile.de.
      </p>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;align-items:flex-start;justify-content:center;">
      <a class="btn primary" href={site.mobileUrl} target="_blank" rel="noopener noreferrer">Zum mobile.de Bestand</a>
      <a class="btn" href="/kontakt/">Kontakt &amp; Anfahrt</a>
    </div>
  </section>

  <hr class="sep" />

  <section class="card" style="padding:18px;display:grid;gap:14px;grid-template-columns:1.2fr .8fr;align-items:center;">
    <div>
      <h2 class="h2">Schnell Kontakt aufnehmen</h2>
      <p class="p" style="margin:8px 0 0;">
        Du hast ein Fahrzeug auf mobile.de gesehen oder möchtest dein Auto verkaufen? Ruf uns an oder nutze das Kontaktformular.
      </p>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;align-items:flex-start;justify-content:center;">
      <a class="btn primary" href="/kontakt/">Kontaktformular</a>
      {site.phones.map((phone) => <a class="btn" href={telHref(phone)}>{phone}</a>)}
    </div>
  </section>
</BaseLayout>

<style>
  @media(max-width:900px){
    .services-grid{grid-template-columns:1fr!important}
    section.card[style*="grid-template-columns"]{grid-template-columns:1fr!important}
  }
</style>
