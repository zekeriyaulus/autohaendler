---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { site, telHref } from "../../../config/site";
---

<BaseLayout
  title={`Live Fahrzeugbestand – ${site.name}`}
  description={`Der Live-Fahrzeugbestand von ${site.name} ist direkt über mobile.de erreichbar.`}
>
  <section class="card" style="padding:22px;">
    <span class="chip">mobile.de</span>
    <h1 class="h1" style="margin-top:12px;">Live Fahrzeugbestand</h1>
    <p class="p" style="max-width:76ch;">
      Der aktuelle Bestand wird derzeit nicht als eingebettete Fahrzeugliste auf der Webseite angezeigt. Bitte öffne den aktuellen Bestand direkt auf mobile.de.
    </p>

    <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;">
      <a class="btn primary" href={site.mobileUrl} target="_blank" rel="noopener noreferrer">mobile.de Profil öffnen</a>
      <a class="btn" href="/kontakt/">Kontakt &amp; Anfahrt</a>
      <a class="btn" href={telHref(site.phones[0])}>Anrufen</a>
    </div>
  </section>
</BaseLayout>
