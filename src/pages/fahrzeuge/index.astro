---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site, telHref } from "../../config/site";
---

<BaseLayout
  title={`Fahrzeugbestand – ${site.name}`}
  description={`Der aktuelle Fahrzeugbestand von ${site.name} ist direkt auf mobile.de abrufbar.`}
>
  <section class="card" style="padding:22px;">
    <span class="chip">Aktuelle Fahrzeuge</span>
    <h1 class="h1" style="margin-top:12px;">Fahrzeugbestand auf mobile.de</h1>
    <p class="p" style="max-width:76ch;">
      Wir zeigen den Fahrzeugbestand aktuell bewusst nicht direkt auf der eigenen Webseite an. So bleiben Preise, Bilder, Ausstattung und Verfügbarkeit immer an einer Stelle sauber gepflegt – im Händlerprofil auf mobile.de.
    </p>

    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px;">
      <a class="btn primary" href={site.mobileUrl} target="_blank" rel="noopener noreferrer">mobile.de Bestand öffnen</a>
      <a class="btn" href="/kontakt/">Kontakt &amp; Anfahrt</a>
      <a class="btn" href={telHref(site.phones[0])}>Jetzt anrufen</a>
    </div>
  </section>

  <section class="grid" style="grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:18px;">
    <div class="card" style="padding:16px;">
      <h2 class="h2">Immer aktuell</h2>
      <p class="small" style="line-height:1.7;">Der Bestand auf mobile.de zeigt die gepflegten Fahrzeugdaten direkt aus dem Händlerprofil.</p>
    </div>
    <div class="card" style="padding:16px;">
      <h2 class="h2">Direkt anfragen</h2>
      <p class="small" style="line-height:1.7;">Bei Interesse einfach anrufen oder über die Kontaktseite melden und das gewünschte Fahrzeug nennen.</p>
    </div>
    <div class="card" style="padding:16px;">
      <h2 class="h2">Vor Ort ansehen</h2>
      <p class="small" style="line-height:1.7;">Besichtigung und Probefahrt am besten kurz vorher telefonisch abstimmen.</p>
    </div>
  </section>
</BaseLayout>

<style>
@media(max-width:900px){section.grid{grid-template-columns:1fr!important}}
</style>
